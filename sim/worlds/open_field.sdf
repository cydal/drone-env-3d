<?xml version="1.0" ?>
<!-- open_field: Level 1 navigation world. Flat ground, a landing pad, no obstacles.
     Physics/plugins and agents are injected by simapi.engine.gazebo.sdf.build_world_sdf. -->
<sdf version="1.9">
  <world name="open_field">
    <!-- @physics -->
    <gravity>0 0 -9.8</gravity>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model><world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.3977</latitude_deg><longitude_deg>8.5456</longitude_deg><elevation>488.0</elevation><heading_deg>0</heading_deg>
    </spherical_coordinates>
    <scene><ambient>0.45 0.45 0.5 1</ambient><background>0.68 0.78 0.9 1</background><shadows>true</shadows></scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><pose>0 0 60 0 0 0</pose>
      <diffuse>0.9 0.88 0.8 1</diffuse><specular>0.3 0.3 0.3 1</specular><direction>-0.4 0.3 -0.85</direction>
    </light>
    <model name="ground"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
        <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
        <material><ambient>0.34 0.38 0.34 1</ambient><diffuse>0.34 0.38 0.34 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
    </link></model>
    <model name="pad_alpha"><static>true</static><pose>0 0 0.05 0 0 0</pose><link name="link">
      <collision name="c"><geometry><cylinder><radius>3</radius><length>0.1</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>3</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
    </link></model>
    <!-- @agents -->
  </world>
</sdf>
