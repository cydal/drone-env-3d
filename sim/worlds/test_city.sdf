<?xml version="1.0" ?>
<!--
  test_city: first world. Deliberately simple; the physics block and agent
  models are injected by simapi.engine.gazebo.sdf.build_world_sdf at load time
  (markers below).
-->
<sdf version="1.9">
  <world name="test_city">
    <!-- @physics -->

    <gravity>0 0 -9.8</gravity>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.3977</latitude_deg>
      <longitude_deg>8.5456</longitude_deg>
      <elevation>488.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.45 0.45 0.5 1</ambient>
      <background>0.68 0.78 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 60 0 0 0</pose>
      <diffuse>0.9 0.88 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -0.85</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <material><ambient>0.32 0.36 0.33 1</ambient><diffuse>0.32 0.36 0.33 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="pad_alpha">
      <static>true</static>
      <pose>0 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>3</radius><length>0.1</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>3</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <model name="pad_bravo">
      <static>true</static>
      <pose>40 25 0.05 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>3</radius><length>0.1</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>3</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <model name="tower_01">
      <static>true</static>
      <pose>20 10 12 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 8 24</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 8 24</size></box></geometry>
          <material><ambient>0.55 0.6 0.68 1</ambient><diffuse>0.55 0.6 0.68 1</diffuse></material></visual>
      </link>
    </model>

    <model name="block_02">
      <static>true</static>
      <pose>-25 15 5 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>14 10 10</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>14 10 10</size></box></geometry>
          <material><ambient>0.62 0.58 0.55 1</ambient><diffuse>0.62 0.58 0.55 1</diffuse></material></visual>
      </link>
    </model>

    <model name="block_03">
      <static>true</static>
      <pose>15 -30 7 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20 12 14</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20 12 14</size></box></geometry>
          <material><ambient>0.5 0.55 0.6 1</ambient><diffuse>0.5 0.55 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_04">
      <static>true</static>
      <pose>-10 -20 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>30 0.6 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>30 0.6 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <model name="deck_05">
      <static>true</static>
      <pose>-40 -35 4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>16 16 8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16 16 8</size></box></geometry>
          <material><ambient>0.58 0.62 0.6 1</ambient><diffuse>0.58 0.62 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- @agents -->
  </world>
</sdf>
